# PostgreSQL local connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datalens_mvp

# Local API only
API_HOST=127.0.0.1
API_PORT=8000

# OpenCode Go (OpenAI-compatible endpoint)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=your_opencode_go_api_key_here
LLM_MODEL=deepseek-v4.1-flash

# Limits & Budgets (P0/P1 defaults)
CSV_MAX_BYTES=2097152
CSV_MAX_FILES=2
CSV_MAX_RECORDS=500
REVIEW_MAX_TEXT_CHARS=2000
REVIEW_MAX_CONTEXT_CHARS=1000
ANALYSIS_MAX_TOKENS_BUDGET=250000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=2
